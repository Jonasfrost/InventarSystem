@page
@model OpretElevModel
@{
    ViewData["Title"] = "Opret Elev";
}

<div class="container mt-4">
    <h2>Opret ny elev</h2>

    <form method="post" class="mt-3">
        <div class="mb-3">
            <label class="form-label">Fornavn</label>
            <input type="text" asp-for="NyElev.Fn" class="form-control" required />
        </div>

        <div class="mb-3">
            <label class="form-label">Efternavn</label>
            <input type="text" asp-for="NyElev.Ln" class="form-control" required />
        </div>

        <div class="mb-3">
            <label class="form-label">E-mail</label>
            <input type="email" asp-for="NyElev.Mail" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Mobil</label>
            <input type="number" asp-for="NyElev.Mobil" class="form-control" />
        </div>

        <button type="submit" class="btn btn-primary">Gem elev</button>
        <a asp-page="/Tilgængelig" class="btn btn-secondary">Annuller</a>
    </form>
</div>