@page
@model EleverModel
@{
    ViewData["Title"] = "Elever";
}

<div class="container mt-4">
    <h2>Elever</h2>
    <a asp-page="/OpretElev" class="btn btn-primary">Tilføj ny elev</a>

    <table class="table table-striped table-bordered mt-3">
        <thead class="table-info">
            <tr>
                <th>Elev ID</th>
                <th>Fornavn</th>
                <th>Efternavn</th>
                <th>E-mail</th>
                <th>Mobil</th>
                <th>Instruktør ID</th>
                <th>Handling</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var elev in Model.EleverListe)
            {
                <tr>
                    <td>@elev.ElevId</td>
                    <td>@elev.Fn </td>
                    <td>@elev.Ln</td>
                    <td>@(elev.Mail ?? "-")</td>
                    <td>@(elev.Mobil ?? "-")</td>
                    <td>@(elev.InstruktorId.HasValue ? elev.InstruktorId.Value.ToString() : "-")</td>
                    <td>
                        <a asp-page="/RedigerElev" asp-route-id="@elev.ElevId" class="btn btn-sm btn-warning">Rediger</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>