@page
@namespace InventarSystem.Pages
@model TilgaengeligModel
@{
    ViewData["Title"] = "Lager";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <!-- TITEL OG SØGEFELT SIDE OM SIDE -->
        <div class="d-flex align-items-center gap-3">
            <h2 class="mb-0">Inventar på lager</h2>
            <form method="get" class="d-flex gap-2">
                <input type="text" name="searchString" value="@Model.CurrentFilter" class="form-control" placeholder="Søg ID, Item" style="width: 280px;" />
                <button type="submit" class="btn btn-outline-primary">Søg</button>
                @if (!string.IsNullOrEmpty(Model.CurrentFilter))
                {
                    <a asp-page="/Tilgaengelig" class="btn btn-outline-secondary">Nulstil</a>
                }
            </form>
        </div>

        <div>
            <a asp-page="/Opret" class="btn btn-success">+ Tilføj nyt inventar</a>
        </div>
    </div>

    <table class="table table-striped table-bordered">
        <thead class="table-info">
            <tr>
                <th>ID</th>
                <th>Item</th>
                <th>Serienummer (SN)</th>
                <th>Antal på lager</th>
                <th>Handling</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.PaaLager != null && Model.PaaLager.Any())
            {
                @foreach (var item in Model.PaaLager)
                {
                    <tr>
                        <td>@item.InventarId</td>
                        <td>@item.Item</td>
                        <td>@item.Sn</td>
                        <td>@item.Antal</td>
                        <td>
                            <div class="d-flex gap-1">
                                <a asp-page="/RedigerInventar" asp-route-id="@item.InventarId" class="btn btn-sm btn-warning">Rediger</a>
                                <a asp-page="/OpretUdlaan" asp-route-inventarId="@item.InventarId" class="btn btn-sm btn-primary @(item.Antal <= 0 ? "disabled" : "")">Udlån</a>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center text-muted">Ingen inventarvarer fundet.</td>
                </tr>
            }
        </tbody>
    </table>
</div>