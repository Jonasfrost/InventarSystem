@page
@namespace InventarSystem.Pages
@model TilgaengeligModel
@{
    ViewData["Title"] = "Lager";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Inventar på lager</h2>
        <div>
            <a asp-page="/Opret" class="btn btn-success">+ Tilføj nyt inventar</a>
        </div>
    </div>

    @if (!ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <div asp-validation-summary="All"></div>
        </div>
    }

    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Item</th>
                <th>Serienummer (SN)</th>
                <th>Antal på lager</th>
                <th>Handling</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.PaaLager)
            {
                <tr>
                    <td>@item.InventarId</td>
                    <td>@item.Item</td>
                    <td>@item.Sn</td>
                    <td>@item.Antal</td>
                    <td>
                        <div class="d-flex gap-1">
                            <a asp-page="/RedigerInventar" asp-route-id="@item.InventarId" class="btn btn-sm btn-warning">Rediger</a>
                            <a asp-page="/OpretUdlaan" asp-route-inventarId="@item.InventarId" class="btn btn-sm btn-primary @(item.Antal <= 0 ? "disabled" : "")">Udlån</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>