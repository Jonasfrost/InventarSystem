@page
@model IndexModel
@{
    ViewData["Title"] = "Udlånte Varer";
}

<div class="container mt-4">
    <!-- TITEL OG SØGEFELT SIDE OM SIDE -->
    <div class="d-flex align-items-center gap-3 mb-4">
        <h2 class="mb-0">Udlånte enheder</h2>
        <form method="get" class="d-flex gap-2">
            <input type="text" name="searchString" value="@Model.CurrentFilter" class="form-control" placeholder="Søg Udlån ID, Elev ID, Vare" style="width: 280px;" />
            <button type="submit" class="btn btn-outline-primary">Søg</button>
            @if (!string.IsNullOrEmpty(Model.CurrentFilter))
            {
                <a asp-page="/Index" class="btn btn-outline-secondary">Nulstil</a>
            }
        </form>
    </div>

    <table class="table table-striped table-bordered mt-3">
        <thead class="table-info">
            <tr>
                <th>Udlån ID</th>
                <th>Elev ID</th>
                <th>Vare Navn</th>
                <th>Antal</th>
                <th>Udlånt Dato</th>
                <th>Afleveret Dato</th>
                <th>Handling</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.UdlaanteVarer != null && Model.UdlaanteVarer.Any())
            {
                @foreach (var udlaan in Model.UdlaanteVarer)
                {
                    // Tjek om datoen er overskredet (og ikke allerede afleveret/udfyldt)
                    bool erOverskredet = udlaan.udlaantAfleveretDato.HasValue && udlaan.udlaantAfleveretDato.Value < DateTime.Now;

                    <tr class="@(erOverskredet ? "table-danger" : "")">
                        <td>@udlaan.udlaantId</td>
                        <td>@udlaan.eleverId</td>
                        <td>@(udlaan.Inventar?.Item ?? "Ukendt vare")</td>
                        <td>@udlaan.udlaantAntal</td>
                        <td>@udlaan.udlaantDato.ToShortDateString()</td>
                        <td class="@(erOverskredet ? "fw-bold text-danger" : "")">
                            @(udlaan.udlaantAfleveretDato?.ToShortDateString() ?? "-")
                        </td>
                        <td>
                            <a asp-page="/RedigerUdlaant" asp-route-id="@udlaan.udlaantId" class="btn btn-sm btn-warning">Rediger</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center text-muted">Ingen udlånte varer fundet.</td>
                </tr>
            }
        </tbody>
    </table>
</div>