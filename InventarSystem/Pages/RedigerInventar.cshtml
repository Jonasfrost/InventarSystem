@page "{id:int}"
@namespace InventarSystem.Pages
@model RedigerInventarModel
@{
    ViewData["Title"] = "Rediger Inventar";
}

<div class="container mt-4">
    <h2>Rediger Inventar</h2>

    <!-- Viser fejl fra databasen hvis sletningen afvises -->
    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <!-- Redigerings-formular -->
    <form method="post" class="mt-3">
        <input type="hidden" asp-for="Vare.InventarId" />

        <div class="mb-3">
            <label class="form-label">Varenavn (Item)</label>
            <input type="text" asp-for="Vare.Item" class="form-control" required />
            <span asp-validation-for="Vare.Item" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Serienummer (SN)</label>
            <input type="text" asp-for="Vare.Sn" class="form-control" />
            <span asp-validation-for="Vare.Sn" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Antal</label>
            <input type="number" asp-for="Vare.Antal" class="form-control" min="0" required />
            <span asp-validation-for="Vare.Antal" class="text-danger"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Gem Ændringer</button>
            <a asp-page="/Tilgængelig" class="btn btn-secondary">Annuller</a>
        </div>
    </form>

    <!-- Separat slette-formular (undgår valideringsblokering og peger på DeleteInventar) -->
    <form method="post" asp-page-handler="DeleteInventar" asp-route-id="@Model.Vare.InventarId" class="mt-2">
        <button type="submit"
                class="btn btn-danger"
                onclick="return confirm('Vil du slette denne vare helt fra lageret og fjerne tilknyttede udlån?');">
            Slet Vare
        </button>
    </form>
</div>