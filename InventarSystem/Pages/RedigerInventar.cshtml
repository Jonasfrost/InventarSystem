@page "{id:int}"
@namespace InventarSystem.Pages
@model RedigerInventarModel
@{
    ViewData["Title"] = "Rediger Inventar";
}

<div class="container mt-4">
    <h2>Rediger Inventar</h2>

    <form method="post" class="mt-3">
        <input type="hidden" asp-for="Vare.InventarId" />

        <div class="mb-3">
            <label class="form-label">Varenavn (Item)</label>
            <input type="text" asp-for="Vare.Item" class="form-control" required />
        </div>

        <div class="mb-3">
            <label class="form-label">Serienummer (SN)</label>
            <input type="text" asp-for="Vare.Sn" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Antal</label>
            <input type="number" asp-for="Vare.Antal" class="form-control" min="0" required />
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Gem Ændringer</button>
            <button type="submit" asp-page-handler="Delete" asp-route-id="@Model.Vare.InventarId" class="btn btn-danger" onclick="return confirm('Vil du slette denne vare?');">Slet</button>
            <a asp-page="/Tilgængelig" class="btn btn-secondary">Annuller</a>
        </div>
    </form>
</div>