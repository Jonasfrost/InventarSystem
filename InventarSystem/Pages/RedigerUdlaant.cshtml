@page "{id:int}"
@namespace InventarSystem.Pages
@model RedigerUdlaantModel
@{
    ViewData["Title"] = "Rediger Udlån";
}

<div class="container mt-4">
    <h2>Rediger Udlån</h2>

    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <!-- Lager-indikator boks -->
    <div class="alert alert-info d-flex justify-content-between align-items-center mb-4">
        <span><strong>Tilgængelig på lager lige nu:</strong> @Model.LagerAntal stk.</span>
        <span class="badge bg-secondary" id="maxInfo">Max muligt udlån: @Model.MaxMulige stk.</span>
    </div>

    <form method="post" class="mt-3">
        <input type="hidden" asp-for="Udlaan.UdlaantId" />
        <input type="hidden" asp-for="Udlaan.InventarId" />
        <input type="hidden" asp-for="Udlaan.EleverId" />

        <!-- Elevens Navn -->
        <div class="mb-3">
            <label class="form-label fw-bold">Elev</label>
            <input type="text" class="form-control" value="@(Model.Udlaan?.Elev?.Navn ?? $"Elev ID: {Model.Udlaan?.EleverId}")" readonly />
        </div>

        <!-- Antal Udlånt -->
        <div class="mb-3">
            <label class="form-label fw-bold">Antal Udlånt</label>
            <input type="number"
                   asp-for="Udlaan.UdlaantAntal"
                   id="antalInput"
                   class="form-control"
                   min="1"
                   required />
            <div id="lagerAdvarsel" class="text-danger fw-bold mt-1" style="display: none;">
                ⚠️ Du overstiger det tilgængelige lager! Du kan højst udlåne <span id="maxSpan">@Model.MaxMulige</span> stk.
            </div>
            <span asp-validation-for="Udlaan.UdlaantAntal" class="text-danger"></span>
        </div>

        <!-- Udlånsdato -->
        <div class="mb-3">
            <label class="form-label">Udlånsdato</label>
            <input type="datetime-local" asp-for="Udlaan.UdlaantDato" class="form-control" required />
            <span asp-validation-for="Udlaan.UdlaantDato" class="text-danger"></span>
        </div>

        <!-- Afleveret Dato -->
        <div class="mb-3">
            <label class="form-label">Afleveret Dato</label>
            <input type="datetime-local" asp-for="Udlaan.UdlaantAfleveretDato" class="form-control" />
            <span asp-validation-for="Udlaan.UdlaantAfleveretDato" class="text-danger"></span>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" id="gemBtn" class="btn btn-primary">Gem Ændringer</button>
            <a asp-page="/Index" class="btn btn-secondary">Annuller</a>
        </div>
    </form>

    <!-- Slet udlån -->
    <form method="post" asp-page-handler="DeleteSingle" asp-route-id="@Model.Udlaan.UdlaantId" class="mt-3">
        <button type="submit"
                class="btn btn-danger"
                onclick="return confirm('Er du sikker på, at du vil slette dette udlån?');">
            Slet Udlån
        </button>
    </form>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const input = document.getElementById("antalInput");
            const advarsel = document.getElementById("lagerAdvarsel");
            const gemBtn = document.getElementById("gemBtn");
            const maxMulige = @Model.MaxMulige;

            function validerAntal() {
                const vaerdi = parseInt(input.value) || 0;

                if (vaerdi > maxMulige) {
                    // Gør tekstfeltet rødt og vis advarsel
                    input.classList.add("is-invalid");
                    input.classList.remove("is-valid");
                    advarsel.style.display = "block";
                    gemBtn.disabled = true; // Bloker gem-knappen
                } else {
                    // Fjern rød markering
                    input.classList.remove("is-invalid");
                    advarsel.style.display = "none";
                    gemBtn.disabled = false;
                }
            }

            input.addEventListener("input", validerAntal);
            validerAntal(); // Kør validering ved indlæsning
        });
    </script>
}