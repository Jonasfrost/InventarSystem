@page "{id:int}"
@namespace InventarSystem.Pages
@model RedigerUdlaantModel
@{
    ViewData["Title"] = "Rediger Udlån";
}

<div class="container mt-4">
    <h2>Rediger Udlån</h2>

    <form method="post" class="mt-3">
        <input type="hidden" asp-for="Udlaan.udlaantId" />

        <div class="mb-3">
            <label class="form-label">Elev ID</label>
            <input type="number" asp-for="Udlaan.eleverId" class="form-control" required />
        </div>

        <div class="mb-3">
            <label class="form-label">Inventar ID</label>
            <input type="number" asp-for="Udlaan.inventarId" class="form-control" required />
        </div>

        <div class="mb-3">
            <label class="form-label">Antal</label>
            <input type="number" asp-for="Udlaan.udlaantAntal" class="form-control" min="1" required />
        </div>

        <div class="mb-3">
            <label class="form-label">Udlånt Dato</label>
            <input type="date" asp-for="Udlaan.udlaantDato" class="form-control" required />
        </div>

        <div class="mb-3">
            <label class="form-label">Afleveret Dato (Valgfri)</label>
            <input type="date" asp-for="Udlaan.udlaantAfleveretDato" class="form-control" />
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Gem Ændringer</button>
            <button type="submit" asp-page-handler="DeleteSingle" asp-route-id="@Model.Udlaan.udlaantId" class="btn btn-danger">
                Aflever vare
            </button>
            <a asp-page="/Index" class="btn btn-secondary">Annuller</a>
        </div>
    </form>
</div>