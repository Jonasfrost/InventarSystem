@page "{inventarId:int}"
@namespace InventarSystem.Pages
@model OpretUdlaanModel
@{
    ViewData["Title"] = "Opret Udlån";
}

<div class="container mt-4">
    <h2>Udlån Vare</h2>

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <form method="post" class="mt-3">
        <input type="hidden" asp-for="Udlaan.InventarId" />

        <div class="mb-3">
            <label class="form-label">Inventar ID</label>
            <input type="number" asp-for="Udlaan.InventarId" class="form-control" readonly />
        </div>

        <div class="mb-3">
            <label class="form-label">Søg / Vælg Elev</label>
            <select id="elevSelect" asp-for="Udlaan.EleverId" class="form-select" required autofocus placeholder="Søg efter navn eller ID...">
                <option value="">-- Vælg elev ved at søge/skrive navn --</option>
                @foreach (var elev in Model.Elever)
                {
                    <option value="@elev.ElevId">@elev.Fn @elev.Ln (ID: @elev.ElevId)</option>
                }
            </select>
            <span asp-validation-for="Udlaan.EleverId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Antal</label>
            <input type="number" asp-for="Udlaan.UdlaantAntal" class="form-control" min="1" required />
            <span asp-validation-for="Udlaan.UdlaantAntal" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Forventet Afleveringsdato</label>
            <input type="date" asp-for="Udlaan.UdlaantAfleveretDato" class="form-control" />
            <span asp-validation-for="Udlaan.UdlaantAfleveretDato" class="text-danger"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-success">Gennemfør Udlån</button>
            <a asp-page="/Tilgængelig" class="btn btn-secondary">Annuller</a>
        </div>
    </form>
</div>
<link href="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/css/tom-select.bootstrap5.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/js/tom-select.complete.min.js"></script>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        new TomSelect("#elevSelect", {
            create: false,
            sortField: {
                field: "text",
                direction: "asc"
            }
        });
    });
</script>