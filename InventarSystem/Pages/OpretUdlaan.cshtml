@page "{inventarId:int}"
@namespace InventarSystem.Pages
@model OpretUdlaanModel
@{
    ViewData["Title"] = "Opret Udlån";
}

<div class="container mt-4">
    <h2>Udlån Vare</h2>

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <form method="post" class="mt-3">
        <input type="hidden" asp-for="Udlaan.inventarId" />

        <div class="mb-3">
            <label class="form-label">Inventar ID</label>
            <input type="number" asp-for="Udlaan.inventarId" class="form-control" readonly />
        </div>

        <div class="mb-3">
            <label class="form-label">Søg / Vælg Elev</label>
            <select asp-for="Udlaan.eleverId" class="form-select" required autofocus>
                <option value="">-- Vælg elev ved at søge/skrive navn --</option>
                @foreach (var elev in Model.Elever)
                {
                    <option value="@elev.ElevId">@elev.Fn (ID: @elev.ElevId)</option>
                }
            </select>
            <span asp-validation-for="Udlaan.eleverId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Antal</label>
            <input type="number" asp-for="Udlaan.udlaantAntal" class="form-control" min="1" required />
            <span asp-validation-for="Udlaan.udlaantAntal" class="text-danger"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-success">Gennemfør Udlån</button>
            <a asp-page="/Tilgængelig" class="btn btn-secondary">Annuller</a>
        </div>
    </form>
</div>